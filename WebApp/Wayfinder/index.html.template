<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<title>Unofficial Atlas9 Wayfinder</title>
<meta name="apple-mobile-web-app-title" content="A9 Wayfinder">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<style>
  * { box-sizing: border-box; }
  button { touch-action: manipulation; font-family: inherit; }
  /* Bottom room (v1.3.3): the page must be tall enough for the route
     box to scroll to the top of the screen. Without it the browser
     stops at the bottom of the document and the box lands mid-screen,
     so a new destination looks like nothing moved. A full viewport of
     space after the footer guarantees the box top can always reach
     the top. */
  body { margin: 0; font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; background: #111; color: #eee; padding-bottom: 100vh; padding-bottom: 100svh; }
  header { position: -webkit-sticky; position: sticky; top: 0; background: #111; padding: 12px 14px 8px; border-bottom: 1px solid #333; z-index: 2; }
  h1 { margin: 0; font-size: 22px; }
  /* Header buttons (v1.3.0): same flex row + pill style as the Field
     Guide's Profile/Spoilers — the title wraps beside them on a
     narrow phone instead of running underneath. */
  .toprow { display: flex; align-items: center; justify-content: space-between; }
  .topbtns { display: flex; gap: 6px; flex-shrink: 0; margin-left: 8px; }
  #configBtn, #spoilerBtn { font-size: 13px; padding: 5px 10px; border-radius: 20px; border: 1px solid #555; background: #222; color: #ccc; cursor: pointer; }
  #spoilerBtn.on { background: #e0a800; border-color: #e0a800; color: #111; font-weight: bold; }
  /* Header icon buttons (v1.4.0): Share and Report are icons, not
     pills — same border/background as the pills, just a glyph. */
  .iconBtn { font-size: 13px; padding: 5px 8px; border-radius: 20px; border: 1px solid #555; background: #222; color: #ccc; cursor: pointer; line-height: 0; }
  .iconBtn svg { width: 16px; height: 16px; vertical-align: middle; }
  h1 small { font-weight: normal; color: #999; font-size: 14px; }
  #ver { color: #e0a800; font-size: 13px; font-weight: normal; margin-left: 6px; background: none; border: none; padding: 0; cursor: pointer; font-family: inherit; }
  main { padding: 12px 14px 30px; max-width: 640px; margin: 0 auto; }
  h2 { font-size: 15px; color: #ccc; margin: 18px 0 8px; }
  .big { display: block; width: 100%; font-size: 18px; padding: 14px 12px; border-radius: 10px; border: 1px solid #555; background: #222; color: #eee; cursor: pointer; text-align: left; }
  .big .meta { display: block; font-size: 14px; color: #aaa; margin-top: 2px; }
  .big.on { background: #e0a800; border-color: #e0a800; color: #111; font-weight: bold; }
  .big.on .meta { color: #333; }
  .big:disabled { opacity: 0.45; cursor: default; }
  .grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; }
  .grid .big { text-align: center; padding: 18px 8px; }
  .hint { color: #888; font-size: 14px; margin-top: 8px; line-height: 1.5; }
  .stairRow { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 9px 0; border-top: 1px solid #333; }
  .stairRow > span:first-child { font-size: 15px; }
  .seg { display: flex; gap: 4px; background: #222; border-radius: 9px; padding: 3px; }
  .seg button { flex: 1; border: 0; padding: 7px 10px; font-size: 13px; border-radius: 7px; background: transparent; color: #ccc; cursor: pointer; white-space: nowrap; }
  .seg button.on { background: #e0a800; color: #111; font-weight: bold; }
  .searchWrap { position: relative; display: block; }
  .searchWrap input { width: 100%; font-size: 18px; padding: 10px 38px 10px 12px; border-radius: 8px; border: 1px solid #555; background: #222; color: #eee; }
  .searchWrap input::placeholder { color: #888; }
  .searchClear { position: absolute; right: 6px; top: 50%; transform: translateY(-50%); border: none; background: transparent; color: #999; font-size: 20px; cursor: pointer; padding: 4px 10px; }
  .searchClear.hidden { display: none; }
  .picker { margin-top: 10px; border: 1px solid #444; border-radius: 10px; background: #1c1c1c; padding: 6px 12px 12px; }
  .picker.hidden { display: none; }
  .connHead { margin-top: 14px; font-size: 15px; font-weight: bold; color: #ccc; }
  .row { display: flex; align-items: center; gap: 10px; width: 100%; padding: 12px 2px; background: none; border: none; border-bottom: 1px solid #2a2a2a; color: #eee; font-size: 17px; text-align: left; cursor: pointer; }
  .row .body { flex: 1; min-width: 0; }
  /* room description under the name (v1.1.0): shows why a search
     matched, so "bar" can be recognised without knowing the room.
     Name and description are inline spans by default, so they run
     together without a gap — both must be block to sit on their
     own lines (v1.1.1 fix). */
  .row .name { display: block; }
  .row .desc { display: block; font-size: 14px; color: #aaa; margin-top: 2px; line-height: 1.4; }
  /* spoiler detail line (v1.3.0): shown under a room's description
     only while Spoilers are on, in gold so it reads as hidden info. */
  .row .desc.spoiler { color: #e0a800; }
  /* second-tier shortcut row (v1.3.0): chips under the category grid,
     Nearest first, then each specific target. */
  #tier2 { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  #tier2.hidden { display: none; }
  #tier2 button { font-size: 16px; padding: 9px 14px; border-radius: 8px; border: 1px solid #555; background: #222; color: #eee; cursor: pointer; }
  #tier2 button.on { background: #e0a800; border-color: #e0a800; color: #111; font-weight: bold; }
  /* third-tier room list (v1.4.2, FAZR only): every room holding the
     tapped FAZR type, under tier 2. Same chip style and gold .on. */
  #tier3 { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  #tier3.hidden { display: none; }
  #tier3 button { font-size: 16px; padding: 9px 14px; border-radius: 8px; border: 1px solid #555; background: #222; color: #eee; cursor: pointer; }
  #tier3 button.on { background: #e0a800; border-color: #e0a800; color: #111; font-weight: bold; }
  .tierHead { width: 100%; color: #aaa; font-size: 13px; margin: 2px 0 0; }
  .row .meta { color: #aaa; font-size: 14px; white-space: nowrap; }
  .row .chev { color: #aaa; font-size: 18px; }
  .row.current { color: #e0a800; }
  #route { margin-top: 16px; border: 1px solid #e0a800; border-radius: 10px; background: #1c1c1c; padding: 12px 14px; }
  #route.hidden { display: none; }
  /* Report nudge (v1.4.6): gold heads-up line under the problem
     kinds; hidden until a pick contradicts what the app lists. */
  #reportNudge.hidden { display: none; }
  #route h2 { margin-top: 0; }
  /* Numbered route steps (v1.3.2): a gold circle with the stop number;
     the row you are standing in gets a dot instead of a number. The
     step name flexes so the floor meta sits at the right edge. */
  .row .stepnum { display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border-radius: 50%; background: #e0a800; color: #111; font-weight: bold; font-size: 14px; flex-shrink: 0; }
  .row .stepnum.start { background: #333; color: #e0a800; }
  /* Checked-off steps (v1.3.4): the number stays, the name strikes
     through and greys out, and a gold check marks the row done — so a
     walked step stays visible for backtracking instead of vanishing. */
  .row.done .name { text-decoration: line-through; color: #888; }
  .row.done .meta { color: #666; }
  .row.done .stepnum { background: #333; color: #999; }
  .row .doneMark { color: #e0a800; font-size: 18px; font-weight: bold; }
  #route .row .name { flex: 1; }
  .summary { font-size: 16px; color: #ddd; margin: 4px 0 8px; }
  .via { text-align: center; color: #e0a800; font-size: 14px; padding: 10px 0 2px; }
  /* Door direction (Via note) under a route step: which door to go
     through to reach that room. Only rendered when a note exists. */
  .viaNote { font-size: 14px; color: #e0a800; padding: 2px 2px 10px; line-height: 1.45; }
  .empty { color: #888; padding: 14px 0; text-align: center; line-height: 1.5; }
  .clearBtn { display: block; width: 100%; margin-top: 14px; font-size: 16px; padding: 11px 0; border-radius: 8px; border: 1px solid #555; background: #2a2a2a; color: #eee; cursor: pointer; }
  /* Room picker selects (v1.4.3 Report, v1.4.4 everywhere): full-width
     dark selects to match the sheet and the pickers. */
  .roomSel { width: 100%; font-size: 16px; padding: 10px; border-radius: 8px; border: 1px solid #555; background: #2a2a2a; color: #eee; }
  footer { color: #777; font-size: 12px; line-height: 1.6; padding: 0 14px 24px; max-width: 640px; margin: 0 auto; }
  footer button { background: none; border: none; color: #e0a800; font-size: 12px; padding: 0; cursor: pointer; text-decoration: underline; }
  /* detail sheet (ported from the Atlas9 Guide): About and Install open here. */
  #sheetWrap { position: fixed; inset: 0; background: rgba(0,0,0,0.65); z-index: 10; display: none; align-items: flex-end; justify-content: center; }
  #sheetWrap.open { display: flex; }
  #sheet { background: #1c1c1c; width: 100%; max-width: 640px; max-height: 88vh; overflow-y: auto; border-radius: 16px 16px 0 0; padding: 10px 18px 28px; }
  /* Top close (v1.4.9): a sticky row holding an × at the top-right,
     so a long sheet can be closed from the top without scrolling to
     the Close button at the bottom. The row sticks to the top of
     the sheet's scroll area with the sheet's own background, so
     content slides under it. (v1.4.10: the grab handle is gone —
     it was decoration promising a swipe-down the app doesn't have.) */
  #sheet .sheetTop { position: sticky; top: 0; z-index: 2; display: flex; align-items: flex-start; justify-content: flex-end; background: #1c1c1c; }
  #sheet .sheetX { flex-shrink: 0; width: 34px; height: 34px; border-radius: 50%; border: 1px solid #555; background: #2a2a2a; color: #eee; font-size: 17px; line-height: 1; cursor: pointer; }
  #sheet h2 { margin: 0 0 4px; font-size: 22px; }
  #sheet .close { display: block; width: 100%; margin-top: 18px; font-size: 16px; padding: 11px 0; border-radius: 8px; border: 1px solid #555; background: #2a2a2a; color: #eee; cursor: pointer; }
  #sheet.large { max-height: 95vh; padding: 16px 20px 32px; }
  #sheet .aboutBody { margin-top: 12px; font-size: 16px; line-height: 1.6; color: #ddd; }
  #sheet .aboutBody p { margin: 0 0 12px; }
  /* Release Notes (v1.3.1): section heading + version lists in About. */
  #sheet .aboutBody h3 { margin: 18px 0 6px; font-size: 17px; color: #fff; }
  #sheet .aboutBody ul { margin: 0 0 12px; padding-left: 20px; }
  #sheet .aboutBody li { margin-bottom: 4px; }
  #sheet .steps { margin: 0 0 12px 20px; line-height: 1.6; }
  #sheet .steps li { margin-bottom: 8px; }
</style>
</head>
<body>
<div id="updateBar" style="position:fixed;top:0;left:0;right:0;z-index:5;display:none;background:#e0a800;color:#111;font-size:15px;padding:10px 14px;align-items:center;gap:10px;justify-content:space-between"><span style="flex:1">A new version of Unofficial Atlas9 Wayfinder is available.</span><button id="updateBtn" style="font-size:15px;font-weight:bold;padding:6px 14px;border-radius:8px;border:1px solid #111;background:#111;color:#e0a800;cursor:pointer;white-space:nowrap">Update</button><button id="updateDismissBtn" style="font-size:15px;font-weight:bold;padding:6px 14px;border-radius:8px;border:1px solid #111;background:transparent;color:#111;cursor:pointer;white-space:nowrap">Dismiss</button></div>
<header>
  <div class="toprow">
    <h1>Unofficial Atlas9 Wayfinder <button id="ver" aria-label="Release notes"></button></h1>
    <div class="topbtns">
      <button id="configBtn">Config</button>
      <button id="spoilerBtn" aria-pressed="false">Spoilers</button>
      <button id="reportBtn" class="iconBtn" aria-label="Report a problem" title="Report a problem"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21V4"/><path d="M5 4h13l-2.5 4L18 12H5"/></svg></button>
      <button id="shareBtn" class="iconBtn" aria-label="Share this app" title="Share this app"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4"/><path d="M7 8l5-5 5 5"/><path d="M5 12v8a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-8"/></svg></button>
    </div>
  </div>
</header>
<main>
  <h2>I am in…</h2>
  <button class="big" id="fromBtn"></button>
  <div class="picker hidden" id="fromPicker">
    <p><select id="fromRoomSel" class="roomSel"></select></p>
    <span class="searchWrap" style="margin-top:8px"><input id="fromSearch" type="search" placeholder="Search rooms…" autocomplete="off"><button id="fromClear" class="searchClear hidden" aria-label="Clear search">✕</button></span>
    <div id="fromList"></div>
  </div>

  <h2>How do I get to…</h2>
  <div class="grid" id="catGrid">
    <button class="big" data-cat="elevator">Elevator</button>
    <button class="big" data-cat="exit">Exit</button>
    <button class="big" data-cat="fazr">FAZR</button>
    <button class="big" data-cat="food">Food</button>
    <button class="big" data-cat="restroom">Restroom</button>
    <button class="big" data-cat="stairs">Stairs</button>
  </div>
  <div id="tier2" class="hidden"></div>
  <div id="tier3" class="hidden"></div>

  <h2>Or go to a room…</h2>
  <p><select id="destRoomSel" class="roomSel"></select></p>
  <span class="searchWrap"><input id="destSearch" type="search" placeholder="Search rooms…" autocomplete="off"><button id="destClear" class="searchClear hidden" aria-label="Clear search">✕</button></span>
  <div id="destList"></div>

  <div id="route" class="hidden"></div>
</main>
<footer>Routes use public connections only — no hidden doors — unless Spoilers are on. Some rooms and routes only appear with Spoilers on. Crawls are left out unless you turn them on in Config. Data from the Atlas9 Data spreadsheet, same rooms file as the Unofficial Atlas9 Field Guide (fan-made, not affiliated with Atlas9). <button id="aboutBtn">About this app</button> · <button id="installBtn">Install on Home Screen</button></footer>
<div id="sheetWrap"><div id="sheet"></div></div>
<script>
const APP_VERSION = '1.4.25';
/* Release notes (v1.3.1): one short list per version, newest first in
   About's Release Notes section. The What's new sheet shows only the
   current version's list. Keep each note to one plain sentence — and
   never name a hidden room or route in a note a spoilers-off user
   could read. */
const WHATS_NEW = {
  '1.4.25': [
    'Config now sets each staircase to Both ways, Up only, or Down only — routes respect your choice.',
  ],
  '1.4.24': [
    'Eight rooms renamed for clarity — Lobby Arcade, Lobby Concessions, Lobby Restrooms, Lobby Stairs, Agent Onboarding, Elevator, Splice Bros. Pizza Restroom, Starbot Restroom.',
    'Seven more Door notes from the sheet (25 in total).',
  ],
  '1.4.23': [
    'Door notes now read as full phrases ("through the…") throughout.',
  ],
  '1.4.22': [
    'Route steps now show the Door notes from the sheet — which door to take, under the step it describes.',
  ],
  '1.4.21': [
    'The update bar now pops up over the title bar instead of pushing the page down, with Update and Dismiss buttons — dismissing hides it until a newer version appears.',
  ],

/* Room <select> options (v1.4.4): every room chooser is a ring picker
   followed by a search. Options are grouped Floor 1 / Floor 2, in
   pickable order; `excludeName` leaves a room out (the destination
   picker leaves out the room you are standing in, like its list). */
function roomOptions(excludeName) {
  const cands = pickableList(spoilersOn, includeCrawls).filter(r => r.name !== excludeName);
  /* v1.4.19, Allen: one A–Z list unless Config separates by floor. */
  if (!separateFloors) {
    return cands.slice().sort((a, b) => a.name.localeCompare(b.name)).map(r => '<option value="' + esc(r.name) + '">' + esc(r.name) + '</option>').join('');
  }
  let html = '';
  for (const [lvl, label] of [[1, 'Floor 1'], [2, 'Floor 2']]) {
    const items = cands.filter(r => r.level === lvl);
    if (!items.length) continue;
    html += '<optgroup label="' + label + '">' + items.map(r => '<option value="' + esc(r.name) + '">' + esc(r.name) + '</option>').join('') + '</optgroup>';
  }
  return html;
}
/* Rebuild the two main-screen room pickers (v1.4.4). The "I am in"
   picker shows the current room; the destination picker shows the
   current destination, or its "Choose a room…" placeholder when
   there is none. */
function renderFromSel() {
  const sel = document.getElementById('fromRoomSel');
  sel.innerHTML = roomOptions(null);
  sel.value = fromName;
}
function renderDestSel() {
  const sel = document.getElementById('destRoomSel');
  sel.innerHTML = '<option value="">Choose a room…</option>' + roomOptions(fromName);
  sel.value = destName || '';
}
function setDestination(name, label, scroll) {
  destName = name;
  destLabel = label;
  /* v1.4.11: choosing a destination clears the "Or go to a room"
     search — stale results sat above the route box and pushed it
     down after the user moved on (e.g. searched "Office", then
     tapped Restroom). Every setDestination call site is a fresh
     destination choice, so this is the single choke point. */
  document.getElementById('destSearch').value = '';
  document.getElementById('destClear').classList.add('hidden');
  renderDestList();
  renderRoute();
  renderDestSel();
  markTier2();
  if (scroll !== false) scrollRouteIntoView();
}
function renderDestList() {
  const q = document.getElementById('destSearch').value;
  /* The long list is gone (v1.4.4) — the picker above covers
     browsing, so an empty search shows only a hint. */
  if (!q.trim()) {
    document.getElementById('destList').innerHTML = '<div class="hint">Type to search rooms.</div>';
    return;
  }
  document.getElementById('destList').innerHTML = roomListHTML(q, fromName, false);
  document.querySelectorAll('#destList [data-room]').forEach(b => {
    b.addEventListener('click', () => setDestination(b.dataset.room, b.dataset.room));
  });
}
function renderFromList() {
  const q = document.getElementById('fromSearch').value;
  /* The long list is gone (v1.4.4) — the picker above covers
     browsing, so an empty search shows only a hint. */
  if (!q.trim()) {
    document.getElementById('fromList').innerHTML = '<div class="hint">Type to search rooms.</div>';
    return;
  }
  document.getElementById('fromList').innerHTML = roomListHTML(q, null, true);
  document.querySelectorAll('#fromList [data-room]').forEach(b => {
    b.addEventListener('click', () => {
      fromName = b.dataset.room;
      renderFrom();
      renderFromSel();
      renderFromList();
      renderDestSel();
      renderDestList();
      if (destName) renderRoute();
      document.getElementById('fromPicker').classList.add('hidden');
      scrollFromIntoView();
    });
  });
}
function wireSearch(inputId, clearId, render) {
  const input = document.getElementById(inputId);
  const clear = document.getElementById(clearId);
  function sync() { clear.classList.toggle('hidden', !input.value); }
  input.addEventListener('input', () => { sync(); render(); });
  clear.addEventListener('click', () => { input.value = ''; sync(); render(); input.focus(); });
  sync();
}
fromBtn.addEventListener('click', () => {
  renderFromSel();
  document.getElementById('fromPicker').classList.toggle('hidden');
});
/* The two main-screen room pickers (v1.4.4): picking from the ring
   does what tapping a search row did. */
document.getElementById('fromRoomSel').addEventListener('change', (e) => {
  fromName = e.target.value;
  renderFrom();
  renderFromSel();
  renderFromList();
  renderDestSel();
  renderDestList();
  if (destName) renderRoute();
  document.getElementById('fromPicker').classList.add('hidden');
  scrollFromIntoView();
});
document.getElementById('destRoomSel').addEventListener('change', (e) => {
  if (!e.target.value) return;
  setDestination(e.target.value, e.target.value);
});

/* --- Two-tier shortcuts (v1.3.0) --- */
/* Tier 1 is the category grid. Elevator and Exit have a single target
   each, so they route at once — no second tier for them. The rest open
   tier 2 below the grid: Nearest first, then each specific target.
   FAZR's tier 2 lists types (Portal included, Allen's call); tapping a
   type routes to the nearest room holding one. */
const tier2Box = document.getElementById('tier2');
let tier2Opts = [];
const tier3Box = document.getElementById('tier3');
/* tier3Idx: index into tier2Opts of the FAZR type whose room list is
   open at tier 3, or null. */
let tier3Idx = null;
/* markTier2 (v1.3.7): the tier-2 button that produced the current
   destination shows the same gold .on state as the tier-1 buttons,
   so you can see at a glance which sub-option you are looking at.
   Derived from destName/destLabel, so it self-corrects whenever the
   destination changes — a room-search pick clears it, a fresh
   tier-2 tap sets it. */
function markTier2() {
  /* Nearest-default (v1.4.1): a nearest route's destination is also
     one of the specific options (nearest stairs from the Lobby IS
     Stairs (Lobby/Starbot)), so without this the gold would land on
     both — the same double-highlight the FAZR fix just cured. A route
     that came from a Nearest option lights only Nearest; a route to a
     specific room lights only that room. */
  const fromNearest = tier2Opts.some(o => !o.dest && destLabel && destLabel.indexOf(o.prefix + ' (') === 0);
  tier2Box.querySelectorAll('[data-tier]').forEach(b => {
    const o = tier2Opts[+b.dataset.tier];
    if (!o) { b.classList.remove('on'); return; }
    /* Third level (v1.4.2): a FAZR type stays gold while its room
       list is open, like a category stays gold while its tier 2 is
       open. */
    const on = o.dest
      ? destName === o.dest && !fromNearest
      : (!!destLabel && destLabel.indexOf(o.prefix + ' (') === 0) || +b.dataset.tier === tier3Idx;
    b.classList.toggle('on', on);
  });
  markTier3();
}
function markTier3() {
  /* Third level (v1.4.2): a room is gold only when the route came
     from tapping that room — a nearest route leaves the list dark,
     the same rule as the tier-2 specifics (v1.4.1). */
  const fromNearest = tier2Opts.some(o => !o.dest && destLabel && destLabel.indexOf(o.prefix + ' (') === 0);
  tier3Box.querySelectorAll('[data-tier3]').forEach(b => {
    b.classList.toggle('on', destName === b.dataset.tier3 && !fromNearest);
  });
}
function tier2Options(cat) {
  const nearest = (targets, prefix) => ({ label: 'Nearest', targets, prefix });
  switch (cat) {
    case 'stairs':
      /* Stair direction (v1.4.25): only list a staircase you can
         actually use from the floor you are standing on — a Down
         only staircase is no use to someone on Floor 1, and vice
         versa. Nearest already skips them via the routing filter. */
      const fromLevel = (byName.get(fromName) || {}).level;
      return [nearest(STAIRS, 'Nearest stairs'),
        ...STAIRS.filter(n => stairEnterAllowed(n, fromLevel, stairDirs)).map(n => ({ label: n, dest: n }))];
    case 'food':
      return [nearest(FOOD_DRINK, 'Nearest food/drink'),
        ...FOOD_DRINK.map(n => ({ label: n, dest: n }))];
    case 'restroom':
      return [nearest(RESTROOMS, 'Nearest restroom'),
        ...RESTROOMS.map(n => ({ label: n, dest: n }))];
    case 'fazr':
      return [nearest(fazrRooms('ANY', spoilersOn), 'Nearest FAZR point'),
        ...FAZR_TYPES.map(t => ({ label: t, targets: fazrRooms(t, spoilersOn), prefix: 'Nearest ' + t }))];
  }
  return [];
}
function clearTier2() {
  clearTier3();
  activeCat = null;
  tier2Box.classList.add('hidden');
  tier2Box.innerHTML = '';
  document.querySelectorAll('#catGrid .big').forEach(b => b.classList.remove('on'));
}
/* Third level (v1.4.2, FAZR only): tapping a FAZR type lists every
   room holding one, so you can pick the exact room instead of the
   nearest. The type tap still routes to the nearest first (v1.4.0);
   the list sits underneath for refining. */
function renderTier3(idx) {
  tier3Idx = idx;
  const o = tier2Opts[idx];
  const head = o.label === 'Nearest' ? 'All FAZR rooms' : o.label + ' rooms';
  tier3Box.innerHTML = '<div class="tierHead">' + esc(head) + '</div>' +
    o.targets.map(r => '<button data-tier3="' + esc(r) + '">' + esc(r) + '</button>').join('');
  tier3Box.classList.remove('hidden');
  tier3Box.querySelectorAll('[data-tier3]').forEach(b => {
    b.addEventListener('click', () => setDestination(b.dataset.tier3, b.dataset.tier3, false));
  });
  markTier2();
}
function clearTier3() {
  tier3Idx = null;
  tier3Box.classList.add('hidden');
  tier3Box.innerHTML = '';
}
/* routeTierOpt (v1.4.0): one tier-2 option, Nearest or specific —
   the tier-2 tap handler and the category tap (Nearest-default) share
   it, so both route the same way. */
function routeTierOpt(o) {
  if (o.dest) { setDestination(o.dest, o.dest, false); return; }
  const p = findNearest(fromName, o.targets, avoidStairs, spoilersOn, includeCrawls, stairDirs);
  if (p) setDestination(p[p.length - 1], o.prefix + ' (' + p[p.length - 1] + ')', false);
}
function renderTier2(cat) {
  clearTier3();
  activeCat = cat;
  document.querySelectorAll('#catGrid .big').forEach(b => b.classList.toggle('on', b.dataset.cat === cat));
  const opts = tier2Opts = tier2Options(cat);
  tier2Box.innerHTML = opts.map((o, i) => '<button data-tier="' + i + '">' + esc(o.label) + '</button>').join('');
  tier2Box.classList.remove('hidden');
  tier2Box.querySelectorAll('[data-tier]').forEach(b => {
    b.addEventListener('click', () => {
      const o = opts[+b.dataset.tier];
      routeTierOpt(o);
      /* Third level (v1.4.2, FAZR only): tapping a FAZR type also
         lists every room of that type underneath, so you can pick the
         exact room instead of the nearest. The other categories
         already list every option at tier 2. */
      if (activeCat === 'fazr' && o.targets) renderTier3(+b.dataset.tier);
    });
  });
  markTier2();
}
document.querySelectorAll('#catGrid [data-cat]').forEach(b => {
  b.addEventListener('click', () => {
    const cat = b.dataset.cat;
    if (cat === 'elevator') {
      clearTier2();
      /* Selected feedback (v1.4.2): any selected button should be
         gold — Elevator and Exit never were, so a tap gave no
         feedback that it was selected. */
      b.classList.add('on');
      const p = findNearest(fromName, [ELEVATOR], avoidStairs, spoilersOn, includeCrawls, stairDirs);
      if (p) setDestination(p[p.length - 1], 'Nearest elevator', false);
      return;
    }
    if (cat === 'exit') {
      clearTier2();
      b.classList.add('on');
      setDestination(EXIT, 'Exit (Containment Zone)', false);
      return;
    }
    if (activeCat === cat) { clearTier2(); return; }
    renderTier2(cat);
    /* Nearest-default (v1.4.0): a multi-choice category routes to
       its nearest right away, with Nearest gold — the sub-buttons
       refine it from there. */
    routeTierOpt(tier2Opts[0]);
  });
});

/* --- Spoilers toggle (v1.3.0) --- */
/* Same pill + gold-on style as the Field Guide. Off on every launch,
   never remembered. Turning it on re-renders the lists and any shown
   route, since the graph itself changes. */
const spoilerBtn = document.getElementById('spoilerBtn');
function renderSpoilers() {
  spoilerBtn.classList.toggle('on', spoilersOn);
  spoilerBtn.setAttribute('aria-pressed', String(spoilersOn));
  sanitizeFrom();
  renderFromSel();
  renderFromList();
  renderDestSel();
  renderDestList();
  if (destName) { refreshRoute(); renderRoute(); }
  if (activeCat === 'fazr') {
    /* Third level (v1.4.2): the room lists depend on Spoilers, so
       re-open the open type's list with fresh targets. */
    const keep3 = tier3Idx;
    renderTier2('fazr');
    if (keep3 !== null) renderTier3(keep3);
  }
}
spoilerBtn.addEventListener('click', () => {
  spoilersOn = !spoilersOn;
  renderSpoilers();
});

/* --- Share + Report (v1.4.0) --- */
/* Share (Allen, 2026-11-20): an icon, not a pill — the standard share
   glyph — in the header next to Config/Spoilers. The sheet has a QR
   code for the app, a link to copy, and the phone's share sheet. The
   QR is a data URI embedded by build.py, so the app stays one
   self-contained file. */
const SHARE_URL = 'https://parkhopping.com/a9nav/';
const SHARE_QR = '__SHARE_QR__';
function shareHTML() {
  return '<h2>Share A9 Wayfinder</h2>' +
    '<div class="aboutBody">' +
    '<p style="text-align:center"><img src="' + SHARE_QR + '" alt="QR code for A9 Wayfinder" style="width:200px;height:200px"></p>' +
    '<p style="text-align:center">' + SHARE_URL + '</p>' +
    '<p><button class="big" id="shareCopyBtn">Copy link</button></p>' +
    '<p><button class="big" id="shareNativeBtn">Share…</button></p>' +
    '</div>';
}
function openShare() {
  openSheet(shareHTML(), true);
  const copyBtn = document.getElementById('shareCopyBtn');
  copyBtn.addEventListener('click', () => {
    const done = () => { copyBtn.textContent = 'Copied!'; setTimeout(() => { copyBtn.textContent = 'Copy link'; }, 1500); };
    const fallbackCopy = () => {
      const ta = document.createElement('textarea');
      ta.value = SHARE_URL;
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); done(); } catch (err) { /* the link stays on screen */ }
      document.body.removeChild(ta);
    };
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(SHARE_URL).then(done).catch(fallbackCopy);
    } else { fallbackCopy(); }
  });
  const nativeBtn = document.getElementById('shareNativeBtn');
  if (navigator.share) {
    nativeBtn.addEventListener('click', () => { navigator.share({ title: 'Unofficial Atlas9 Wayfinder', url: SHARE_URL }).catch(() => {}); });
  } else { nativeBtn.style.display = 'none'; }
}
document.getElementById('shareBtn').addEventListener('click', openShare);

/* Report (Allen, 2026-11-20): a small flag icon in the sticky header,
   always visible mid-walk. The sheet is tap-only — no typing in the
   app (typing details here would be wasted: the form opens next and
   the details get typed once, there). Item type defaults to the
   current destination's type when it is a findable type; problem kind
   must be picked; the room comes from the sheet's own room picker
   (v1.4.3), defaulting to "I am in". The button opens the Guide's
   research form pre-filled
   (type → about, room → where, problem kind → found). Responses go to
   Allen for review; nothing writes to the sheet or the app. */
const RESEARCH_FORM_URL = 'https://docs.google.com/forms/d/e/1FAIpQLSceMVSAV7Ftea5aQto59eDOZGeZrIZKFcddHl3MkiY3V77pGA/viewform';
const RESEARCH_FORM_ENTRY = { about: '2144553325', found: '1939760705', where: '828332630' };
const REPORT_KINDS = ['Listed here but not actually there', 'There but not listed'];
let reportType = 'FAZR';
let reportKind = '';
let reportRoom = '';
/* First item type recorded for a room (v1.4.3): the default type when
   the Report room changes. A room with nothing recorded falls back
   to FAZR. */
function firstTypeForRoom(room) {
  const pts = FAZR_POINTS.filter(p => p.room === room);
  return pts.length ? pts[0].type : 'FAZR';
}
function defaultReportType() {
  for (const t of ['Movie Poster', 'Computer', 'INTERFAZE', 'FAZR-Portal']) {
    if (destLabel && destLabel.indexOf('Nearest ' + t + ' (') === 0) return t;
  }
  if (destLabel && destLabel.indexOf('Nearest FAZR') === 0) return 'FAZR';
  return firstTypeForRoom(reportRoom);
}
function reportHTML() {
  return '<h2>Report a problem</h2>' +
    '<div class="aboutBody">' +
    '<p>Something wrong or missing — a FAZR, Computer, Movie Poster or INTERFAZE that has moved or is not listed. Pick the room, then what it is and what is wrong, then the report form opens pre-filled. Nothing is saved here.</p>' +
    '<p><strong>Room</strong></p>' +
    '<p><select id="reportRoomSel" class="roomSel">' + pickableList(spoilersOn, includeCrawls).map(r => '<option value="' + esc(r.name) + '"' + (r.name === reportRoom ? ' selected' : '') + '>' + esc(r.name) + '</option>').join('') + '</select></p>' +
    '<span class="searchWrap"><input id="reportSearch" type="search" placeholder="Search rooms…" autocomplete="off"></span>' +
    '<div id="reportList"></div>' +
    '<p><strong>What is it?</strong></p>' +
    FAZR_TYPES.map(t => '<p><button class="big reportType' + (t === reportType ? ' on' : '') + '" data-type="' + t + '">' + t + '</button></p>').join('') +
    '<p><strong>What is wrong?</strong></p>' +
    REPORT_KINDS.map(k => '<p><button class="big reportKind" data-kind="' + esc(k) + '">' + k + '</button></p>').join('') +
    '<p id="reportNudge" class="viaNote hidden"></p>' +
    '<p><button class="big" id="reportOpenBtn" disabled>Open the report form</button></p>' +
    '</div>';
}
function openReport() {
  reportRoom = fromName;
  reportType = defaultReportType();
  reportKind = '';
  openSheet(reportHTML(), true);
  const openBtn = document.getElementById('reportOpenBtn');
  const syncOpen = () => { openBtn.disabled = !reportKind; };
  /* Nudge (v1.4.6): the kinds only make sense one way round for a
     given room + type — "There but not listed" means the room does
     not list one, "Listed here but not actually there" means it
     does. If the pick contradicts what the app lists, say so — but
     never block it, since a room can hold a second object of the
     same type that is not listed yet. */
  const nudgeEl = document.getElementById('reportNudge');
  const syncNudge = () => {
    let msg = '';
    if (reportKind && reportType) {
      const listed = fazrRooms(reportType, spoilersOn).indexOf(reportRoom) >= 0;
      if (reportKind === 'There but not listed' && listed) msg = 'Heads up: this room already lists a ' + reportType + ' — is this a different one?';
      if (reportKind === 'Listed here but not actually there' && !listed) msg = 'Heads up: this room does not list a ' + reportType + ' — is that the right type?';
    }
    nudgeEl.textContent = msg;
    nudgeEl.classList.toggle('hidden', !msg);
  };
  document.getElementById('reportRoomSel').addEventListener('change', (e) => {
    reportRoom = e.target.value;
    reportType = firstTypeForRoom(reportRoom);
    sheet.querySelectorAll('.reportType').forEach(x => x.classList.toggle('on', x.dataset.type === reportType));
    syncNudge();
  });
  /* Report room search (v1.4.4): the picker covers browsing, the
     search covers finding a room by name. A tap sets the picker. */
  const reportSearch = document.getElementById('reportSearch');
  const renderReportList = () => {
    const q = reportSearch.value.trim();
    const list = document.getElementById('reportList');
    if (!q) { list.innerHTML = ''; return; }
    list.innerHTML = roomListHTML(q, null, false);
    list.querySelectorAll('[data-room]').forEach(b => {
      b.addEventListener('click', () => {
        reportRoom = b.dataset.room;
        reportType = firstTypeForRoom(reportRoom);
        document.getElementById('reportRoomSel').value = reportRoom;
        sheet.querySelectorAll('.reportType').forEach(x => x.classList.toggle('on', x.dataset.type === reportType));
        reportSearch.value = '';
        list.innerHTML = '';
        syncNudge();
      });
    });
  };
  reportSearch.addEventListener('input', renderReportList);
  sheet.querySelectorAll('.reportType').forEach(b => {
    b.addEventListener('click', () => {
      reportType = b.dataset.type;
      sheet.querySelectorAll('.reportType').forEach(x => x.classList.toggle('on', x === b));
      syncNudge();
    });
  });
  sheet.querySelectorAll('.reportKind').forEach(b => {
    b.addEventListener('click', () => {
      reportKind = b.dataset.kind;
      sheet.querySelectorAll('.reportKind').forEach(x => x.classList.toggle('on', x === b));
      syncOpen();
      syncNudge();
    });
  });
  openBtn.addEventListener('click', () => {
    if (!reportKind) return;
    const params = {};
    params[RESEARCH_FORM_ENTRY.about] = reportType;
    params[RESEARCH_FORM_ENTRY.found] = reportKind;
    params[RESEARCH_FORM_ENTRY.where] = reportRoom;
    let url = RESEARCH_FORM_URL + '?usp=pp_url';
    for (const k in params) url += '&entry.' + k + '=' + encodeURIComponent(params[k] || '');
    window.open(url, '_blank');
  });
  syncOpen();
  syncNudge();
}
document.getElementById('reportBtn').addEventListener('click', openReport);
wireSearch('fromSearch', 'fromClear', renderFromList);
wireSearch('destSearch', 'destClear', renderDestList);
sanitizeFrom();
renderFrom();
renderAvoid();
renderFromSel();
renderFromList();
renderDestSel();
renderDestList();

/* --- App infrastructure, ported from the Atlas9 Guide --- */
/* Detail sheet: About and Install open here. */
const sheetWrap = document.getElementById('sheetWrap');
const sheet = document.getElementById('sheet');
function openSheet(html, large, noClose) {
  sheet.innerHTML = '<div class="sheetTop">' +
    (noClose ? '' : '<button class="sheetX" id="sheetX" aria-label="Close">✕</button>') + '</div>' + html +
    (noClose ? '' : '<button class="close" id="sheetClose">Close</button>');
  sheet.classList.toggle('large', !!large);
  sheetWrap.classList.add('open');
  /* v1.4.12: the scroll reset must run AFTER the sheet is shown.
     v1.4.11 set scrollTop = 0 while the sheet was still hidden
     (display:none) — a no-op — so a new sheet kept the previous
     sheet's scroll position. The rAF repeat covers scroll
     anchoring re-applying the old offset after layout. */
  sheet.scrollTop = 0;
  requestAnimationFrame(() => { sheet.scrollTop = 0; });
  sheetWrap.classList.add('open');
  const sc = document.getElementById('sheetClose');
  if (sc) sc.addEventListener('click', closeSheet);
  const sx = document.getElementById('sheetX');
  if (sx) sx.addEventListener('click', closeSheet);
}
function closeSheet() { sheetWrap.classList.remove('open'); sheet.classList.remove('large'); }
sheetWrap.addEventListener('click', (e) => { if (e.target === sheetWrap) closeSheet(); });

/* Config (v1.2.0): the stairs/elevator choice lives here, not on the
   main screen — like the Field Guide's Profile button top-right.
   Defaults live here; Avoid stairs is the first one. */
/* Include crawls state (v1.3.1): same pattern as Avoid stairs — the
   sheet's own toggle/hint update if it is open, and the lists and any
   shown route re-render, since the graph itself changes. */
function renderCrawls() {
  const cfgBtn = document.getElementById('configCrawlsBtn');
  if (cfgBtn) {
    cfgBtn.textContent = 'Include crawls: ' + (includeCrawls ? 'On' : 'Off');
    cfgBtn.classList.toggle('on', includeCrawls);
    cfgBtn.setAttribute('aria-pressed', String(includeCrawls));
  }
  const cfgHint = document.getElementById('configCrawlsHint');
  if (cfgHint) cfgHint.textContent = includeCrawls
    ? 'Crawls are routable — the tight passages count as rooms.'
    : 'Crawls left out — routes use proper rooms only.';
  sanitizeFrom();
  renderFromSel();
  renderFromList();
  renderDestSel();
  renderDestList();
  if (destName) { refreshRoute(); renderRoute(); }
}
/* Separate rooms by floor (v1.4.19, Allen): off (the default) the room
   pickers and search results are one A–Z list; on they group under
   Floor 1 and Floor 2 again. Saved with the other settings. */
function renderFloors() {
  const cfgBtn = document.getElementById('configFloorsBtn');
  if (cfgBtn) {
    cfgBtn.textContent = 'Separate rooms by floor: ' + (separateFloors ? 'On' : 'Off');
    cfgBtn.classList.toggle('on', separateFloors);
    cfgBtn.setAttribute('aria-pressed', String(separateFloors));
  }
  const cfgHint = document.getElementById('configFloorsHint');
  if (cfgHint) cfgHint.textContent = separateFloors
    ? 'Room pickers and search results group rooms under Floor 1 and Floor 2.'
    : 'Room pickers and search results show one A–Z list.';
  renderFromSel();
  renderFromList();
  renderDestSel();
  renderDestList();
  saveSettings();
}
function configHTML() {
  return '<h2>Config</h2>' +
    '<div class="aboutBody">' +
    '<p><button class="big" id="configAvoidBtn" aria-pressed="false"></button></p>' +
    '<p class="hint" id="configAvoidHint"></p>' +
    '<p><button class="big" id="configCrawlsBtn" aria-pressed="false"></button></p>' +
    '<p class="hint" id="configCrawlsHint"></p>' +
    '<p><button class="big" id="configFloorsBtn" aria-pressed="false"></button></p>' +
    '<p class="hint" id="configFloorsHint"></p>' +
    '<h3>Stairs</h3>' +
    '<p class="hint">Which way each staircase can be used. Down only stairs are skipped going up, and vice versa. The Elevator is always available both ways.</p>' +
    '<div id="configStairs"></div>' +
    '<p class="hint" id="configStairsHint"></p>' +
    '<p>Defaults live here. More options can be added as the app grows.</p>' +
    '<p>Your settings are saved on this phone only. An app update may reset them — that’s expected, not a bug.</p>' +
    '</div>';
}
/* Stair directions (v1.4.25, Allen): each staircase gets Both / Up
   only / Down only. The section dims while Avoid stairs is on — no
   stairs are used at all then, so the choices are moot. */
const STAIR_DIR_LABELS = [['both', 'Both'], ['up', 'Up only'], ['down', 'Down only']];
function renderStairs() {
  const wrap = document.getElementById('configStairs');
  if (!wrap) return;
  wrap.innerHTML = STAIRS.map(n => {
    const cur = stairDirs[n] || 'both';
    return '<div class="stairRow"><span>' + esc(n) + '</span><span class="seg">' +
      STAIR_DIR_LABELS.map(([v, label]) =>
        '<button data-stair="' + esc(n) + '" data-dir="' + v + '"' + (v === cur ? ' class="on"' : '') + '>' + label + '</button>'
      ).join('') + '</span></div>';
  }).join('');
  wrap.querySelectorAll('[data-stair]').forEach(b => {
    b.addEventListener('click', () => {
      stairDirs[b.dataset.stair] = b.dataset.dir;
      saveSettings();
      renderStairs();
      if (destName) { refreshRoute(); renderRoute(); }
    });
  });
  const hint = document.getElementById('configStairsHint');
  if (hint) hint.textContent = avoidStairs
    ? 'Hidden while Avoid stairs is on — no stairs are used at all.'
    : 'Applies to routes through each staircase.';
  wrap.style.opacity = avoidStairs ? '0.4' : '1';
  wrap.style.pointerEvents = avoidStairs ? 'none' : 'auto';
}
function openConfig() {
  openSheet(configHTML(), true);
  renderAvoid();
  renderCrawls();
  renderFloors();
  renderStairs();
  document.getElementById('configAvoidBtn').addEventListener('click', () => {
    avoidStairs = !avoidStairs;
    renderAvoid();
  });
  document.getElementById('configCrawlsBtn').addEventListener('click', () => {
    includeCrawls = !includeCrawls;
    renderCrawls();
  });
  document.getElementById('configFloorsBtn').addEventListener('click', () => {
    separateFloors = !separateFloors;
    renderFloors();
  });
}
document.getElementById('configBtn').addEventListener('click', openConfig);

/* About / first-run: explains the app. Unofficial Atlas9 Wayfinder stores nothing —
   no account, no saved finds. The starting room and Avoid stairs last
   only while the page is open. */
const WELCOME_KEY = 'a9nav-welcomed';
/* Release Notes section (v1.3.1): every shipped version, newest first.
   The What's new sheet after an update shows only the new version. */
function releaseNotesHTML() {
  let html = '';
  for (const v of RELEASE_VERSIONS) {
    const notes = WHATS_NEW[v] || [];
    html += '<p><strong>v' + v + '</strong></p><ul>' + notes.map(n => '<li>' + esc(n) + '</li>').join('') + '</ul>';
  }
  return html;
}
/* What's new sheet (v1.3.1): the current version's notes only, shown
   once after an update. The wording stays vague on purpose — a
   spoilers-off user reads this, so no hidden room or route is named. */
function whatsNewHTML(version) {
  const notes = WHATS_NEW[version] || [];
  /* No "Got it" button here (v1.3.5) — the sheet's own Close button
     dismisses it, like every other sheet. */
  return '<h2>What’s new in v' + version + '</h2>' +
    '<div class="aboutBody">' +
    (notes.length ? '<ul>' + notes.map(n => '<li>' + esc(n) + '</li>').join('') + '</ul>' : '<p>No notes for this version.</p>') +
    '</div>';
}
function openWhatsNew(version) {
  openSheet(whatsNewHTML(version), true);
}
function aboutHTML() {
  return '<h2>About this app</h2>' +
    '<div class="aboutBody">' +
    '<p><button id="aboutCheckUpdate" style="font-size:15px;padding:9px 16px;border-radius:8px;border:1px solid #555;background:#2a2a2a;color:#eee;cursor:pointer">Check for updates</button> <span id="aboutUpdateMsg" style="color:#999;font-size:14px"></span></p>' +
    (isStandalone ? '' : '<p><button id="aboutInstall" style="font-size:15px;padding:9px 16px;border-radius:8px;border:1px solid #555;background:#2a2a2a;color:#eee;cursor:pointer">Install on Home Screen</button></p>') +
    '<p>Unofficial Atlas9 Wayfinder is a fan-made wayfinding tool for the Atlas9 experience in Kansas City, KS. It is not affiliated with Atlas9.</p>' +
    '<p>Pick the room you are in, then pick a category — Stairs, Elevator, Food, Restroom, Exit or FAZR — and choose Nearest or a specific one. FAZR offers FAZR, Movie Poster, Computer, INTERFAZE and FAZR-Portal. Or pick any room to go to: search matches room names and descriptions, so “guitar” or “bar” finds a room even when you don’t know its name.</p>' +
    '<p><strong>Config</strong> (top right) holds <strong>Avoid stairs</strong>, which routes by elevator only, and <strong>Include crawls</strong>, which lets routes use the crawl passages. It also holds <strong>per-staircase directions</strong> — each staircase can be Both ways, Up only, or Down only. <strong>Spoilers</strong> (top right) enables hidden routes and hidden items. Spoilers are off on every launch.</p>' +
    '<p>The <strong>flag</strong> (top right) reports a FAZR, Computer, Movie Poster or INTERFAZE that is listed but not there, or there but not listed. The <strong>share</strong> icon (top right) shares the app with a QR code or a link.</p>' +
    '<p>Your starting room and settings are saved on this phone only. There is no account and nothing is sent to a server. <strong>Spoilers</strong> are never saved — they start off every time you open the app.</p>' +
    '<h3>Release Notes</h3>' + releaseNotesHTML() +
    '</div>';
}
function openAbout() {
  openSheet(aboutHTML(), true);
  const inst = document.getElementById('aboutInstall');
  if (inst) inst.addEventListener('click', openInstall);
  document.getElementById('aboutCheckUpdate').addEventListener('click', () => runUpdateCheck(document.getElementById('aboutUpdateMsg')));
}
/* Install on Home Screen: iPhone Safari and Android Chrome offer no
   JavaScript install prompt the app can trigger, so the instructions open
   as a sheet right here on top of the app — adding from here adds
   A9 Wayfinder itself, not an instructions page. */
const isStandalone = window.navigator.standalone === true || window.matchMedia('(display-mode: standalone)').matches;
function installHTML() {
  const ua = navigator.userAgent || '';
  const isIOS = /iPhone|iPad|iPod/.test(ua);
  const isAndroid = /Android/.test(ua);
  let steps;
  if (isIOS) {
    steps = '<ol class="steps"><li>Open A9 Wayfinder in <strong>Safari</strong>. If you are reading this inside another app, use its share menu and choose “Open in Safari”.</li><li>Tap the <strong>Page Menu</strong> button — the three-line icon — then tap <strong>Share</strong>. (If your tabs sit at the bottom or top of the screen, tap the <strong>Share</strong> button — the square with an arrow — directly.)</li><li>Scroll down and tap <strong>“Add to Home Screen”</strong>. (Don’t see it? Scroll to the very bottom, tap <strong>Edit Actions</strong>, then tap <strong>+ Add to Home Screen</strong>.)</li><li>Turn on <strong>Open as Web App</strong>.</li><li>Tap <strong>Add</strong>. A9 Wayfinder appears on your Home Screen like an app.</li></ol><p>On older iOS, tap the Share button at the bottom of the screen, then “Add to Home Screen”.</p>';
  } else if (isAndroid) {
    steps = '<ol class="steps"><li>Tap the <strong>⋮ menu</strong> in the top right of Chrome.</li><li>Tap <strong>“Add to Home screen”</strong> (or “Install app”).</li><li>Tap <strong>Add</strong> / <strong>Install</strong>. A9 Wayfinder appears on your Home Screen like an app.</li></ol>';
  } else {
    steps = '<p>On an <strong>iPhone</strong>, open A9 Wayfinder in Safari, tap the Page Menu button (three-line icon), then Share, then “Add to Home Screen”, turn on “Open as Web App”, and tap Add. On <strong>Android</strong>, open it in Chrome, tap the ⋮ menu, then “Add to Home screen”. There is no install button the app itself can show — your phone adds it from the browser menu.</p>';
  }
  return '<h2>Install on Home Screen</h2>' +
    '<div class="aboutBody">' +
    '<p>Adding A9 Wayfinder to your Home Screen makes it open like an app — full screen, with its own icon.</p>' +
    steps +
    '<p>These instructions open right here on top of A9 Wayfinder, so what you add is the app itself — not an instructions page.</p>' +
    '</div>';
}
function openInstall() { openSheet(installHTML(), true); }
if (isStandalone) { document.getElementById('installBtn').style.display = 'none'; }
else { document.getElementById('installBtn').addEventListener('click', openInstall); }
document.getElementById('aboutBtn').addEventListener('click', openAbout);

/* Update check: iOS home-screen apps resume from the background without
   reloading, so a new version would sit unseen until the app is force-quit.
   When the page becomes visible again (and every 5 minutes while open), fetch
   version.json and offer a one-tap Update that reloads the page. */
const updateBar = document.getElementById('updateBar');
document.getElementById('updateBtn').addEventListener('click', () => location.reload());
/* Dismiss (v1.4.21): hides the bar until a newer version appears — the
   5-minute / visibility checks must not pop it straight back. A manual
   "Check for updates" clears the dismissal (see runUpdateCheck). */
let latestSeenVersion = '';
let dismissedUpdateVersion = '';
document.getElementById('updateDismissBtn').addEventListener('click', () => {
  dismissedUpdateVersion = latestSeenVersion;
  updateBar.style.display = 'none';
});
let updateChecked = false;
function checkForUpdate(quiet) {
  fetch('version.json?v=' + Date.now()).then(r => r.json()).then(v => {
    const latest = (v && v.version) || '';
    latestSeenVersion = latest;
    if (latest && latest !== APP_VERSION && latest !== dismissedUpdateVersion) {
      updateBar.style.display = 'flex';
    } else if (!quiet) {
      updateBar.style.display = 'none';
    }
    updateChecked = true;
  }).catch(() => {});
}
document.addEventListener('visibilitychange', () => { if (!document.hidden) checkForUpdate(true); });
window.addEventListener('pageshow', () => checkForUpdate(true));
setInterval(() => { if (!document.hidden) checkForUpdate(true); }, 5 * 60 * 1000);

/* First run: show About once, so a new user sees what the app is. */
const wasWelcomed = !!localStorage.getItem(WELCOME_KEY);
if (!wasWelcomed) {
  localStorage.setItem(WELCOME_KEY, '1');
  openAbout();
}
/* What's new (v1.3.1): after an update, show the new version's notes
   once. A stored version that differs means a normal update; a
   welcomed user with no stored version is upgrading from before this
   screen existed (1.3.0 or earlier) — they get it too. First install
   shows About instead, never What's new. */
const SEEN_VERSION_KEY = 'a9nav-seen-version';
const seenVersion = localStorage.getItem(SEEN_VERSION_KEY);
if ((seenVersion && seenVersion !== APP_VERSION) || (!seenVersion && wasWelcomed)) {
  openWhatsNew(APP_VERSION);
}
localStorage.setItem(SEEN_VERSION_KEY, APP_VERSION);
</script>
</body>
</html>

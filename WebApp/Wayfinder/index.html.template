const RELEASE_VERSIONS = ['1.4.25', '1.4.24', '1.4.23', '1.4.22', '1.4.21', '1.4.20', '1.4.19', '1.4.18', '1.4.17', '1.4.16', '1.4.15', '1.4.14', '1.4.13', '1.4.12', '1.4.11', '1.4.10', '1.4.9', '1.4.8', '1.4.7', '1.4.6', '1.4.5', '1.4.4', '1.4.3', '1.4.2', '1.4.1', '1.4.0', '1.3.7', '1.3.6', '1.3.5', '1.3.4', '1.3.3', '1.3.2', '1.3.1', '1.3.0', '1.2.0'];
document.getElementById('ver').textContent = 'v' + APP_VERSION;
/* Version tap (v1.4.10): tapping the version number in the header
   opens the release notes in their own sheet. */
document.getElementById('ver').addEventListener('click', openReleaseNotes);
/* Check for updates (shared by About and Release Notes, v1.4.15):
   fetches version.json; a newer version closes the sheet and shows the
   gold update bar, otherwise the message says you're current. */
function runUpdateCheck(msgEl) {
  msgEl.textContent = 'Checking…';
  fetch('version.json?v=' + Date.now()).then(r => r.json()).then(v => {
    const latest = (v && v.version) || '';
    if (latest && latest !== APP_VERSION) {
      msgEl.textContent = '';
      closeSheet();
      dismissedUpdateVersion = '';
      updateBar.style.display = 'flex';
    } else {
      msgEl.textContent = 'You are on the latest version (v' + APP_VERSION + ').';
    }
  }).catch(() => { msgEl.textContent = 'Could not check — are you online?'; });
}
